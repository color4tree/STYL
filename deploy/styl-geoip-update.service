[Unit]
Description=Refresh STYL GeoLite2 Country database
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0027
ExecStart=/opt/styl/backend/.venv/bin/python /usr/local/lib/styl/update_geoip.py
TimeoutStartSec=7min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/cache/styl-geoip /var/lib/styl-geoip
