[Unit]
Description=Maintain STYL analytics and send a due daily aggregate report
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=styl
Group=styl
WorkingDirectory=/opt/styl/backend
EnvironmentFile=/etc/styl/styl.env
ExecStart=/opt/styl/backend/.venv/bin/python -m app.analytics_reports run-due
TimeoutStartSec=10min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/styl-analytics
