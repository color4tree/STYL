# Copy to /etc/styl/styl.env and replace every value before starting the services.
STYL_ADMIN_TOKEN=replace-with-a-long-random-token
STYL_DATA_DIR=/var/lib/styl
STYL_ALLOWED_ORIGINS=https://example.com

# Optional server-local country MMDB. Missing/unavailable => unknown location, CAD.
# Provision this file separately; see docs/geoip-pricing.md. No lookup web service is used.
STYL_GEOIP_DATABASE=/var/lib/styl-geoip/GeoLite2-Country.mmdb

# Comma-separated recipients; defaults to styl@stylfitness.com if omitted.
STYL_INQUIRY_RECIPIENTS=styl@stylfitness.com
# Enter SMTP secrets only on the server.
# Gmail requires 2-Step Verification and an app password allowed by your Workspace policy.
STYL_SMTP_HOST=smtp.gmail.com
STYL_SMTP_PORT=587
STYL_SMTP_USERNAME=styl@stylfitness.com
STYL_SMTP_PASSWORD=
STYL_SMTP_FROM=styl@stylfitness.com

# Aggregate-only analytics has no browser/session IDs or consent panel.
# Keep production disabled until the privacy-reviewed rollout is approved.
STYL_ANALYTICS_ENABLED=false
STYL_ANALYTICS_ENVIRONMENT=production
STYL_ANALYTICS_DB=/var/lib/styl-analytics/analytics.sqlite3
STYL_ANALYTICS_TIMEZONE=America/Los_Angeles
STYL_ANALYTICS_CAMPAIGN_ALLOWLIST=
# Separate internal report recipients. Never inherit customer/quote recipients.
STYL_ANALYTICS_EMAIL_ENABLED=false
STYL_ANALYTICS_RECIPIENTS=
STYL_ANALYTICS_REPLY_TO=
STYL_ANALYTICS_DASHBOARD_URL=https://stylfitness.com/admin
